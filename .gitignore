# Platform-managed agentplat state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.plugins/
/.opencode-skills/
tests/
test-results/
playwright-report/
# Keep the listing-summary contract regression in source control.
!tests/
tests/*
!tests/e2e/
tests/e2e/*
!tests/e2e/listings/
tests/e2e/listings/*
!tests/e2e/listings/summary.spec.ts
!tests/e2e/listings/pagination.spec.ts
!tests/e2e/listings/rejected-content.spec.ts
!tests/e2e/listings/refusal-notification.spec.ts

# Keep authentication, metadata, and translation regressions in source control.
!tests/e2e/auth/
tests/e2e/auth/*
!tests/e2e/auth/confirmation.spec.ts
!tests/e2e/auth/reset-password.spec.ts
!tests/e2e/header/
